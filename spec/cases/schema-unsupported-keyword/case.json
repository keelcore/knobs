{
  "description": "A schema using a keyword its draft does not define fails, naming the keyword and where it is.",
  "args": [
    "--app",
    "demo",
    "--schema",
    "{schema}/invalid/unsupported-keyword.json"
  ],
  "command": "resolve",
  "expect_error": {
    "error": {
      "code": "schema_invalid",
      "layer": "schema",
      "keywords": [
        {
          "keyword": "patern",
          "location": "#/properties/name"
        }
      ]
    }
  }
}
