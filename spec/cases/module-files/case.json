{
  "description": "A module's own files hold its mapping directly and override the application's file in the same layer.",
  "args": [
    "--app",
    "demo",
    "--schema",
    "{schema}/http.json",
    "--global",
    "global.yaml",
    "--module-global",
    "http=http-global.yaml",
    "--module-user",
    "http=http-user.yaml"
  ],
  "command": "resolve",
  "expect": {
    "values": {
      "demo.http.port": {
        "value": 9001,
        "layer": "global",
        "secret": false
      },
      "demo.http.host": {
        "value": "::1",
        "layer": "user",
        "secret": false
      },
      "demo.http.read_timeout": {
        "value": "5s",
        "layer": "schema",
        "secret": false
      },
      "demo.http.mode": {
        "value": "strict",
        "layer": "schema",
        "secret": false
      },
      "demo.http.ratio": {
        "value": 0.5,
        "layer": "schema",
        "secret": false
      },
      "demo.http.debug": {
        "value": false,
        "layer": "schema",
        "secret": false
      }
    }
  }
}
