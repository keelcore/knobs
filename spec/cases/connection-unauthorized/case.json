{
  "description": "Without authorization no connection override applies.",
  "args": [
    "--app",
    "demo",
    "--schema",
    "{schema}/http.json",
    "--connection",
    "demo.http.port=9000"
  ],
  "command": "resolve",
  "expect": {
    "values": {
      "demo.http.port": {
        "value": 8080,
        "layer": "schema",
        "secret": false
      },
      "demo.http.host": {
        "value": "127.0.0.1",
        "layer": "schema",
        "secret": false
      },
      "demo.http.read_timeout": {
        "value": "5s",
        "layer": "schema",
        "secret": false
      },
      "demo.http.mode": {
        "value": "strict",
        "layer": "schema",
        "secret": false
      },
      "demo.http.ratio": {
        "value": 0.5,
        "layer": "schema",
        "secret": false
      },
      "demo.http.debug": {
        "value": false,
        "layer": "schema",
        "secret": false
      }
    },
    "attempts": [
      {
        "key": "demo.http.port",
        "outcome": "rejected_unauthorized"
      }
    ]
  }
}
