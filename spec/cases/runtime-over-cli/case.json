{
  "description": "runtime overrides cli.",
  "args": [
    "--app",
    "demo",
    "--schema",
    "{schema}/http.json",
    "--knob",
    "demo.http.port=9090",
    "--runtime",
    "demo.http.port=9191"
  ],
  "command": "resolve",
  "expect": {
    "values": {
      "demo.http.port": {
        "value": 9191,
        "layer": "runtime",
        "secret": false
      },
      "demo.http.host": {
        "value": "127.0.0.1",
        "layer": "schema",
        "secret": false
      },
      "demo.http.read_timeout": {
        "value": "5s",
        "layer": "schema",
        "secret": false
      },
      "demo.http.mode": {
        "value": "strict",
        "layer": "schema",
        "secret": false
      },
      "demo.http.ratio": {
        "value": 0.5,
        "layer": "schema",
        "secret": false
      },
      "demo.http.debug": {
        "value": false,
        "layer": "schema",
        "secret": false
      }
    }
  }
}
