{
  "description": "The file-name knob <APP>_KNOBS_FILE_NAME names the user file.",
  "args": [
    "--app",
    "demo",
    "--schema",
    "{schema}/http.json",
    "--standard",
    "--env",
    "XDG_CONFIG_HOME=.",
    "--env",
    "APPDATA=.",
    "--env",
    "DEMO_KNOBS_FILE_NAME=keel.yaml"
  ],
  "command": "resolve",
  "expect": {
    "values": {
      "demo.http.port": {
        "value": 9002,
        "layer": "user",
        "secret": false
      },
      "demo.http.host": {
        "value": "127.0.0.1",
        "layer": "schema",
        "secret": false
      },
      "demo.http.read_timeout": {
        "value": "5s",
        "layer": "schema",
        "secret": false
      },
      "demo.http.mode": {
        "value": "strict",
        "layer": "schema",
        "secret": false
      },
      "demo.http.ratio": {
        "value": 0.5,
        "layer": "schema",
        "secret": false
      },
      "demo.http.debug": {
        "value": false,
        "layer": "schema",
        "secret": false
      }
    }
  }
}
