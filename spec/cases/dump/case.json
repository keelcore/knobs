{
  "description": "dump writes the resolved tree rooted at the application, secrets redacted.",
  "args": [
    "--app",
    "demo",
    "--schema",
    "{schema}/http.json",
    "--schema",
    "{schema}/db.json",
    "--knob",
    "demo.db.url=x",
    "--env",
    "DEMO_DB_PASSWORD=hunter2"
  ],
  "command": "dump",
  "expect": {
    "demo": {
      "http": {
        "port": 8080,
        "host": "127.0.0.1",
        "read_timeout": "5s",
        "mode": "strict",
        "ratio": 0.5,
        "debug": false
      },
      "db": {
        "url": "x",
        "password": "<redacted>",
        "pool": 4
      }
    }
  }
}
