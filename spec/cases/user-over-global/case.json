{
  "description": "The user file overrides the global file key by key.",
  "args": [
    "--app",
    "demo",
    "--schema",
    "{schema}/http.json",
    "--global",
    "global.yaml",
    "--user",
    "user.yaml"
  ],
  "command": "resolve",
  "expect": {
    "values": {
      "demo.http.port": {
        "value": 9100,
        "layer": "user",
        "secret": false
      },
      "demo.http.host": {
        "value": "127.0.0.1",
        "layer": "default",
        "secret": false
      },
      "demo.http.read_timeout": {
        "value": "5s",
        "layer": "default",
        "secret": false
      },
      "demo.http.mode": {
        "value": "lenient",
        "layer": "global",
        "secret": false
      },
      "demo.http.ratio": {
        "value": 0.5,
        "layer": "default",
        "secret": false
      },
      "demo.http.debug": {
        "value": false,
        "layer": "default",
        "secret": false
      }
    }
  }
}
