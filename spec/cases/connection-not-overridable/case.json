{
  "description": "A key without x-knobs-connection, a secret, or a key no schema defines is not connection-overridable.",
  "args": [
    "--app",
    "demo",
    "--schema",
    "{schema}/http.json",
    "--schema",
    "{schema}/db.json",
    "--knob",
    "demo.db.url=x",
    "--connection",
    "demo.http.host=0.0.0.0",
    "--connection",
    "demo.db.password=guess",
    "--authorized",
    "--connection",
    "demo.http.nope=1"
  ],
  "command": "resolve",
  "expect": {
    "values": {
      "demo.http.port": {
        "value": 8080,
        "layer": "default",
        "secret": false
      },
      "demo.http.host": {
        "value": "127.0.0.1",
        "layer": "default",
        "secret": false
      },
      "demo.http.read_timeout": {
        "value": "5s",
        "layer": "default",
        "secret": false
      },
      "demo.http.mode": {
        "value": "strict",
        "layer": "default",
        "secret": false
      },
      "demo.http.ratio": {
        "value": 0.5,
        "layer": "default",
        "secret": false
      },
      "demo.http.debug": {
        "value": false,
        "layer": "default",
        "secret": false
      },
      "demo.db.pool": {
        "value": 4,
        "layer": "default",
        "secret": false
      },
      "demo.db.url": {
        "value": "x",
        "layer": "cli",
        "secret": false
      }
    },
    "attempts": [
      {
        "key": "demo.db.password",
        "outcome": "rejected_not_overridable"
      },
      {
        "key": "demo.http.host",
        "outcome": "rejected_not_overridable"
      },
      {
        "key": "demo.http.nope",
        "outcome": "rejected_not_overridable"
      }
    ]
  }
}
