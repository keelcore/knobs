{
  "description": "cli overrides env.",
  "args": [
    "--app",
    "demo",
    "--schema",
    "{schema}/http.json",
    "--env",
    "DEMO_HTTP_PORT=8081",
    "--knob",
    "demo.http.port=9090"
  ],
  "command": "resolve",
  "expect": {
    "values": {
      "demo.http.port": {
        "value": 9090,
        "layer": "cli",
        "secret": false
      },
      "demo.http.host": {
        "value": "127.0.0.1",
        "layer": "default",
        "secret": false
      },
      "demo.http.read_timeout": {
        "value": "5s",
        "layer": "default",
        "secret": false
      },
      "demo.http.mode": {
        "value": "strict",
        "layer": "default",
        "secret": false
      },
      "demo.http.ratio": {
        "value": 0.5,
        "layer": "default",
        "secret": false
      },
      "demo.http.debug": {
        "value": false,
        "layer": "default",
        "secret": false
      }
    }
  }
}
