{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/keelcore/knobs/spec/schema/db.json",
  "title": "db",
  "description": "Test schema: a required key, a secret, a mapped environment name.",
  "x-knobs-module": "db",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "url"
  ],
  "properties": {
    "url": {
      "type": "string",
      "description": "Database URL."
    },
    "password": {
      "type": "string",
      "description": "Database password.",
      "x-knobs-secret": true
    },
    "pool": {
      "type": "integer",
      "description": "Connection pool size.",
      "default": 4,
      "minimum": 1,
      "maximum": 64,
      "x-knobs-env": "DB_POOL"
    }
  }
}
